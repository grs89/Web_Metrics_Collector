            "options": {
                "getOption": "const serverLoc = [-74.07, 4.71]; // Bogota, CO\n\ntry {\n  const data = context.panel.data;\n  // 1. Check Data Presence\n  if (typeof data === 'undefined' || !data || !data.series || !data.series[0]) {\n    return {\n      backgroundColor: 'transparent',\n      title: {\n        text: 'DEBUG: Data Missing. ' + (typeof data === 'undefined' ? 'UNDEFINED' : 'EMPTY'),\n        left: 'center',\n        textStyle: { color: 'red', fontSize: 14 }\n      }\n    };\n  }\n\n  const source = data.series[0];\n  const fieldNames = source.fields.map(f => f.name).join(', ');\n\n  // 2. Find Columns (Case Insensitive)\n  const latIdx = source.fields.findIndex(f => f.name.toLowerCase() === 'latitude');\n  const lonIdx = source.fields.findIndex(f => f.name.toLowerCase() === 'longitude');\n  let cntIdx = source.fields.findIndex(f => f.name.toLowerCase() === 'request_count');\n  if (cntIdx === -1) cntIdx = source.fields.findIndex(f => f.name.toLowerCase() === 'count');\n\n  // 3. Debug Column Mismatch\n  if (latIdx === -1 || lonIdx === -1) {\n    return {\n      backgroundColor: 'transparent',\n      title: {\n        text: 'DEBUG: Missing Cols. Found: ' + fieldNames,\n        left: 'center',\n        textStyle: { color: 'red', fontSize: 12 }\n      }\n    };\n  }\n\n  const routes = [];\n  const points = [];\n\n  for (let i = 0; i < source.length; i++) {\n    const lat = source.fields[latIdx].values[i];\n    const lon = source.fields[lonIdx].values[i];\n    const count = cntIdx > -1 ? source.fields[cntIdx].values[i] : 1;\n    \n    if (lat && lon) {\n      points.push({ name: '', value: [lon, lat, count] });\n      routes.push({\n        coords: [[lon, lat], serverLoc],\n        value: count\n      });\n    }\n  }\n\n  points.push({ name: 'Server', value: serverLoc, itemStyle: { color: '#f00' } });\n\n  return {\n    backgroundColor: 'transparent',\n    tooltip: { trigger: 'item' },\n    geo: {\n      map: 'world',\n      roam: true,\n      silent: true,\n      itemStyle: {\n        normal: {\n          borderColor: 'rgba(255,255,255,0.1)',\n          areaColor: 'rgba(50,50,50,0.5)'\n        }\n      }\n    },\n    series: [\n      {\n        type: 'lines',\n        coordinateSystem: 'geo',\n        zlevel: 2,\n        lineStyle: {\n          normal: {\n            color: '#a6c84c',\n            width: 1,\n            opacity: 0.4,\n            curveness: 0.2\n          }\n        },\n        data: routes\n      },\n      {\n        type: 'lines',\n        coordinateSystem: 'geo',\n        zlevel: 3,\n        effect: {\n          show: true,\n          period: 4,\n          trailLength: 0.2,\n          color: '#fff',\n          symbol: 'arrow',\n          symbolSize: 5\n        },\n        lineStyle: {\n          normal: {\n            color: '#c0cbff',\n            width: 0,\n            curveness: 0.2\n          }\n        },\n        data: routes\n      },\n      {\n        type: 'effectScatter',\n        coordinateSystem: 'geo',\n        zlevel: 3,\n        rippleEffect: {\n          brushType: 'stroke'\n        },\n        itemStyle: {\n           color: '#a6c84c'\n        },\n        data: points\n      }\n    ]\n  };\n} catch (e) {\n  console.error('ECharts Error:', e);\n  return {\n    title: {\n        text: 'JS Error: ' + e.message,\n        left: 'center',\n        textStyle: { color: 'red' }\n    }\n  };\n}",
                "map": "json",
                "renderer": "canvas"
            },
