                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT\n  client_ip,\n  country_code,\n  city,\n  COUNT(*) AS total_requests,\n  ROUND(\n    100.0 * SUM(CASE WHEN status_code >= 400 THEN 1 ELSE 0 END) / COUNT(*),\n    1\n  ) AS error_rate_pct,\n  BOOL_OR(is_fake_bot) AS is_fake_bot,\n  MODE() WITHIN GROUP (ORDER BY bot_category) AS bot_category\nFROM web_access_logs\nWHERE\n  $__timeFilter(timestamp)\n  AND (\n    is_fake_bot = true\n    OR bot_category IN ('BadBot', 'Malicious')\n    OR status_code IN (400, 401, 403, 404, 429)\n  )\nGROUP BY client_ip, country_code, city\nORDER BY total_requests DESC\nLIMIT 10;",
                    "refId": "A"
                }
