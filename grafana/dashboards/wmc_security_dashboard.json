                    "rawSql": "SELECT\n  latitude,\n  longitude,\n  country_code,\n  city,\n  COUNT(*) as count\nFROM web_access_logs\nWHERE\n  $__timeFilter(timestamp)\n  AND latitude IS NOT NULL\n  AND longitude IS NOT NULL\n  AND (\n    is_fake_bot = true\n    OR bot_category IN ('BadBot', 'Malicious')\n    OR status_code IN (400, 401, 403, 404, 429)\n  )\nGROUP BY latitude, longitude, country_code, city\nORDER BY count DESC\nLIMIT 500;",
