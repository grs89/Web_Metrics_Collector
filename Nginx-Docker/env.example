# ═══════════════════════════════════════════════════════════════════════════
# WGP - Web Geo Profiler - Environment Configuration
# Supports: Nginx, Apache
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL Configuration
POSTGRES_USER=wgp_user
POSTGRES_PASSWORD=wgp_secure_password_2024
POSTGRES_DB=web_logs

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
GRAFANA_ROOT_URL=http://localhost:3000

# Log Processor Configuration
# Valid values: nginx, apache
DEFAULT_SERVER_TYPE=nginx

# Batch processing settings
BATCH_SIZE=100
FLUSH_INTERVAL=5.0
