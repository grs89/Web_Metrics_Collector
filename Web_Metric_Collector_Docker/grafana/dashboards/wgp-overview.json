                    "rawQuery": true,
                    "rawSql": "SELECT \n  date_trunc('minute', timestamp) AS time,\n  COALESCE(source_host, 'unknown') AS metric,\n  COUNT(*) AS requests\nFROM web_access_logs \nWHERE $__timeFilter(timestamp)\n  AND ($source_host = 'All' OR source_host = '$source_host')\n  AND ($server_type = 'All' OR server_type = '$server_type')\nGROUP BY date_trunc('minute', timestamp), source_host\nORDER BY time",
