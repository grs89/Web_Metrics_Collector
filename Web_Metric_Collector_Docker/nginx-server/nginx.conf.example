# ═══════════════════════════════════════════════════════════════════════════
# NGP - Example Nginx Configuration for Remote Server
# ═══════════════════════════════════════════════════════════════════════════
#
# Add this log_format to your existing nginx.conf on your remote server.
# This JSON format is required for proper parsing by the NGP system.
#
# ═══════════════════════════════════════════════════════════════════════════

# Add this inside the 'http' block of your nginx.conf:

http {
    # ... your existing configuration ...

    # ═══════════════════════════════════════════════════════════════════════
    # JSON Log Format for NGP (Nginx Geo Profiler)
    # ═══════════════════════════════════════════════════════════════════════
    log_format json_combined escape=json
        '{'
            '"timestamp":"$time_iso8601",'
            '"remote_addr":"$remote_addr",'
            '"remote_user":"$remote_user",'
            '"request_method":"$request_method",'
            '"request_uri":"$request_uri",'
            '"request":"$request",'
            '"status":$status,'
            '"body_bytes_sent":$body_bytes_sent,'
            '"request_time":$request_time,'
            '"http_referer":"$http_referer",'
            '"http_user_agent":"$http_user_agent",'
            '"http_x_forwarded_for":"$http_x_forwarded_for",'
            '"upstream_response_time":"$upstream_response_time",'
            '"upstream_addr":"$upstream_addr",'
            '"host":"$host",'
            '"server_name":"$server_name",'
            '"ssl_protocol":"$ssl_protocol",'
            '"ssl_cipher":"$ssl_cipher",'
            '"request_length":$request_length,'
            '"connection":$connection,'
            '"connection_requests":$connection_requests,'
            '"gzip_ratio":"$gzip_ratio"'
        '}';

    # Use the JSON format for access logs
    access_log /var/log/nginx/access.log json_combined;

    # ... rest of your configuration ...
}

